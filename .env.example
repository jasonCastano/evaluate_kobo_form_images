# Copy this file to `.env` and fill in the values. `.env` is ignored by Git.

# Optional KoboToolbox API key. When set, the app signs in automatically on start;
# otherwise sign in from the sidebar (username & password or API key).
# Kobo > Account settings > Security > API key.
KOBO_API_TOKEN=

# Optional folders (relative to the project root).
# KOBO_FORMS_DIR=forms
# KOBO_DATA_DIR=data
# EVALUATIONS_DIR=evaluations
# IMAGE_CACHE_DIR=.cache/images
